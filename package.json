{
  "name": "bigapple-events-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-app.mjs",
    "build:catalog": "node scripts/build-app.mjs --catalog-only",
    "start": "node server/index.mjs",
    "dev:api": "PORT=3001 node server/index.mjs",
    "test": "node --test scripts/activity-selection.test.mjs tests/*.test.mjs",
    "db:backup": "node scripts/backup-data.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:gateways": "node scripts/prepare-gateways.mjs",
    "preview": "node server/index.mjs"
  },
  "engines": { "node": ">=24.0.0" },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
